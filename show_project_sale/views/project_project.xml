<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="show_project_sale_form" model="ir.ui.view">
        <field name="name">Show Project Sale Form Inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="show_project.project_form"/>
        <field name="arch" type="xml">
            <field name="show_date" position="after">
                <field name="sale_currency_id" invisible="1"/>
                <field name="show_hour" widget="float_time" invisible="show_type != 'show'"/>
                <field name="show_duration" invisible="show_type != 'show'"/>
                <field name="door_hour" widget="float_time" invisible="show_type != 'show'"/>
                <field name="artist_start_hour" widget="float_time" invisible="show_type != 'show'"/>
                <field name="artist_id" position="move"/>
                <field name="other_artists" invisible="show_type != 'show'"/>
                <field name="has_intermission" invisible="show_type != 'show'"/>
                <label for="has_accomodation" invisible="show_type != 'show'"/>
                <div invisible="show_type != 'show'" class="o_row">
                    <field name="has_accomodation" class="oe_inline"/>
                    <field name="accomodation" invisible="not has_accomodation" required="has_accomodation"/>
                </div>
                <label for="has_meal" invisible="show_type != 'show'"/>
                <div invisible="show_type != 'show'" class="o_row">
                    <field name="has_meal" invisible="show_type != 'show'" class="oe_inline"/>
                    <field name="meals" invisible="not has_meal"/>
                </div>
            </field>

            <xpath expr="//notebook" position="inside">
                <page string="Sale" name="sale_tab" invisible="show_type != 'show'">
                    <group>
                        <group string="Tickets" col="1">
                            <group>
                                <field name="artist_favour_tickets"/>
                                <field name="diffisor_favour_tickets"/>
                            </group>
                            <group col="1">
                                <label for="ticket_price_ids"/>
                                <field name="ticket_price_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="segment_id"/>
                                        <field name="price"/>
                                        <field name="currency_id" invisible="1"/>
                                    </list>
                                </field>
                                <label for="service_fee_ids"/>
                                <field name="service_fee_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="segment_id"/>
                                        <field name="price"/>
                                        <field name="currency_id" invisible="1"/>
                                    </list>
                                </field>
                            </group>
                        </group>
                        <group string="Variable Income">
                            <field name="has_benefits_sharing"/>
                            <field name="benefits_sharing_rate" string="Applicable Rate" widget="percentage" invisible="not has_benefits_sharing" required="has_benefits_sharing"/>
                            <field name="benefits_sharing_type" invisible="not has_benefits_sharing" required="has_benefits_sharing"/>
                            <field name="benefits_sharing_amount_before" widget="monetary" options="{'currency_field': 'sale_currency_id'}" invisible="not has_benefits_sharing or benefits_sharing_type != 'after_fixed_amount'" required="has_benefits_sharing and benefits_sharing_type == 'after_fixed_amount'"/>
                            <field name="benefits_sharing_forcasted_expense" widget="monetary" options="{'currency_field': 'sale_currency_id'}" invisible="not has_benefits_sharing or benefits_sharing_type != 'after_real_costs'" required="has_benefits_sharing and benefits_sharing_type == 'after_real_costs'"/>
                        </group>
                    </group>
                    <label for="sales_note"/>
                    <newline/>
                    <field name="sales_note"/>
                    <newline/>
                    <label for="other_contract_terms"/>
                    <newline/>
                    <field name="other_contract_terms"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>