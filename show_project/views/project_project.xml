<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="project_form" model="ir.ui.view">
        <field name="name">show.project.edit.project.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="priority">17</field>
        <field name="arch" type="xml">
            <!-- Add field project type under Allow Timesheets -->
            <xpath expr="//notebook" position="before">
                <div>
                    <field name="show_type" widget="radio"/>
                    <field name="expected_parent_show_type" invisible="1"/>
                </div>
            </xpath>

            <!-- Mark readonly Name field when project type is show -->
            <field name="name" position="attributes">
                <attribute name="readonly">show_type == 'show'</attribute>
                <!--TODO: Result from converting 'attrs' attribute override without options for ['invisible', 'required', 'column_invisible'] to separate attributes
                     Remove redundant empty tags below for any of those attributes that are not present in the field tag in any of the parent views
                     If someone later adds one of these attributes in the parent views, they would likely be unaware it's still overridden in this view, resulting in unexpected behaviour, which should be avoided-->
                <!--TODO: Result from 'attrs' -> 'invisible' conversion without also overriding 'states' attribute
                     Check if this field tag contained a states attribute in any of the parent views, that should be combined into this 'invisible' attribute
                     (If any states attributes existed in parent views, they'll also be marked with a TODO)-->
                <attribute name="invisible"/>
                <attribute name="required"/>
                <attribute name="column_invisible"/>
                <attribute name="force_save">1</attribute>
            </field>

            <!-- Hide Parent Project field when project type is tour -->
            <!-- Parent Project is required when project type is show -->
            <field name="parent_id" position="attributes">
                <!--TODO: Result from converting 'attrs' attribute override without options for ['invisible', 'required', 'readonly', 'column_invisible'] to separate attributes
                     Remove redundant empty tags below for any of those attributes that are not present in the field tag in any of the parent views
                     If someone later adds one of these attributes in the parent views, they would likely be unaware it's still overridden in this view, resulting in unexpected behaviour, which should be avoided-->
                <!--TODO: Result from 'attrs' -> 'invisible' conversion without also overriding 'states' attribute
                     Check if this field tag contained a states attribute in any of the parent views, that should be combined into this 'invisible' attribute
                     (If any states attributes existed in parent views, they'll also be marked with a TODO)-->
                <attribute name="invisible"/>
                <attribute name="required"/>
                <attribute name="readonly"/>
                <attribute name="column_invisible"/>
            </field>

            <!-- Hide Customer field when project type is tour -->
            <field name="partner_id" position="attributes">
                <!--TODO: Result from 'attrs' -> 'invisible' conversion without also overriding 'states' attribute
                     Check if this field tag contained a states attribute in any of the parent views, in which case it should be combined into this 'invisible' attribute
                     (If any states attributes existed in parent views, they'll also be marked with a TODO)-->
                <attribute name="invisible">show_type == 'tour'</attribute>
                <!--TODO: Result from converting 'attrs' attribute override without options for ['required', 'readonly', 'column_invisible'] to separate attributes
                     Remove redundant empty tags below for any of those attributes that are not present in the field tag in any of the parent views
                     If someone later adds one of these attributes in the parent views, they would likely be unaware it's still overridden in this view, resulting in unexpected behaviour, which should be avoided-->
                <attribute name="required"/>
                <attribute name="readonly"/>
                <attribute name="column_invisible"/>
            </field>

            <!-- Hide project_type field when project not show -->
            <field name="project_type_id" position="attributes">
                <!--TODO: Result from 'attrs' -> 'invisible' conversion without also overriding 'states' attribute
                     Check if this field tag contained a states attribute in any of the parent views, in which case it should be combined into this 'invisible' attribute
                     (If any states attributes existed in parent views, they'll also be marked with a TODO)-->
                <attribute name="invisible">show_type != 'show'</attribute>
                <!--TODO: Result from converting 'attrs' attribute override without options for ['required', 'readonly', 'column_invisible'] to separate attributes
                     Remove redundant empty tags below for any of those attributes that are not present in the field tag in any of the parent views
                     If someone later adds one of these attributes in the parent views, they would likely be unaware it's still overridden in this view, resulting in unexpected behaviour, which should be avoided-->
                <attribute name="required"/>
                <attribute name="readonly"/>
                <attribute name="column_invisible"/>
            </field>

            <!-- Add fields in configuration tab and only visible when project type is show -->
            <field name="user_id" position="before">
                <field name="showcase" invisible="show_type != 'show'"/>
                <field name="formula" invisible="show_type != 'show'"/>
            </field>
            <field name="partner_id" position="after">
                <field name="recording" invisible="show_type != 'show'"/>
                <field name="producer_id" invisible="show_type != 'show'"/>
            </field>

            <!-- Only show date_start and date fields when project type is standard or tour -->
            <field name="date_start" position="attributes">
                <!--TODO: Result from 'attrs' -> 'invisible' conversion without also overriding 'states' attribute
                     Check if this field tag contained a states attribute in any of the parent views, in which case it should be combined into this 'invisible' attribute
                     (If any states attributes existed in parent views, they'll also be marked with a TODO)-->
                <attribute name="invisible">show_type == 'show'</attribute>
                <!--TODO: Result from converting 'attrs' attribute override without options for ['required', 'readonly', 'column_invisible'] to separate attributes
                     Remove redundant empty tags below for any of those attributes that are not present in the field tag in any of the parent views
                     If someone later adds one of these attributes in the parent views, they would likely be unaware it's still overridden in this view, resulting in unexpected behaviour, which should be avoided-->
                <attribute name="required"/>
                <attribute name="readonly"/>
                <attribute name="column_invisible"/>
            </field>

            <field name="date" position="attributes">
                <!--TODO: Result from 'attrs' -> 'invisible' conversion without also overriding 'states' attribute
                     Check if this field tag contained a states attribute in any of the parent views, in which case it should be combined into this 'invisible' attribute
                     (If any states attributes existed in parent views, they'll also be marked with a TODO)-->
                <attribute name="invisible">show_type == 'show'</attribute>
                <!--TODO: Result from converting 'attrs' attribute override without options for ['required', 'readonly', 'column_invisible'] to separate attributes
                     Remove redundant empty tags below for any of those attributes that are not present in the field tag in any of the parent views
                     If someone later adds one of these attributes in the parent views, they would likely be unaware it's still overridden in this view, resulting in unexpected behaviour, which should be avoided-->
                <attribute name="required"/>
                <attribute name="readonly"/>
                <attribute name="column_invisible"/>
            </field>

            <!-- Add new field show_date under date field -->
            <field name="date" position="after">
                <field name="show_date" invisible="show_type != 'show'" required="show_type == 'show'"/>
                <field name="artist_id" required="show_type == 'show'"/>
            </field>

            <!-- Add new tab `Show Place` when project type is `show` -->
            <xpath expr="//page[@name='settings']" position="after">
                <page string="Show Venue" name="show_venue" invisible="show_type != 'show'">
                    <group>
                        <group>
                            <field name="show_place_id" required="show_type == 'show'"/>
                            <field name="city"/>
                            <field name="show_place_configuration_id" string="Configuration"/>
                            <field name="show_place_configuration"/>
                            <field name="show_place_maximum_capacity"/>
                            <field name="show_place_minor_restriction"/>
                            <field name="show_place_distance_from_productor"/>
                            <field name="show_place_stage" string="Stage"/>
                            <field name="show_place_notes" string="Notes"/>
                            <field name="previous_show_id"/>
                            <field name="next_show_id"/>
                        </group>
                    </group>
                    <group string="Diffuser's Contacts">
                        <field name="diffuser_ids" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>